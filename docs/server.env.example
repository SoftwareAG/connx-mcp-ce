#     with the License. You may obtain a copy of the License at https://www.apache.org/licenses/LICENSE-2.0
#     Unless required by applicable law or agreed to in writing, software distributed under the License is distributed
#     on an "AS IS" BASIS, WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied. See the License
#     for the specific language governing permissions and limitations under the License.


# === Credentials

# CONNX login that the server uses.
# Required.
CDD_USERNAME=

# Password of the CONNX login.
# Required. Empty: the CONNX login has no password. Secret: keep this file private.
CDD_PASSWORD=


# === CONNX engine and licence

# Host name of the CONNX licence server; host.docker.internal when the licence server runs on this machine.
# CONNX_LICENSE_HOST=

# Port of the CONNX licence server.
# Used when CONNX_LICENSE_HOST is set. Default: 7501.
# CONNX_LICENSE_PORT=7501

# CONNX host that replaces the host in the CDD.
# CONNX_HOST=


# === Listener and sessions

# URL path the MCP endpoint is served on.
# Default: /mcp.
# MCP_PATH=/mcp

# Seconds an idle MCP session is kept.
# Default: 300. Minimum: 60.
# MCP_SESSION_TIMEOUT_SECONDS=300

# Seconds between two checks for idle sessions.
# Default: 60. Minimum: 1.
# MCP_SESSION_CLEANUP_INTERVAL_SECONDS=60

# Comma-separated browser origins allowed to call the server.
# Default: empty. Empty: every browser origin except the server's own is blocked.
# MCP_TRUSTED_ORIGINS=

# Seconds to wait for each dependency at startup; 0 refuses at once.
# Default: 120. Minimum: 0.
# MCP_STARTUP_WAIT_SECONDS=120


# === TLS (HTTPS)

# Serve HTTPS with the certificate in /opt/softwareag/connx/mcp/certs in the container; when that directory is empty,
# the server generates a self-signed certificate.
# Default: false. Choices: false, true.
# MCP_TLS_ENABLED=false

# Comma-separated host names and IP addresses that harnesses use; a generated certificate is for the first host, and
# with several pairs the server uses the pair named after it.
# Used when MCP_TLS_ENABLED is true.
# MCP_TLS_HOSTS=

# Key type of a generated certificate.
# Used when MCP_TLS_ENABLED is true. Default: rsa2048. Choices: rsa2048, rsa3072, rsa4096, ec-p256, ec-p384.
# MCP_TLS_KEY_TYPE=rsa2048

# Days a generated certificate is valid; to renew it, delete the generated pair from /opt/softwareag/connx/mcp/certs and
# restart the server.
# Used when MCP_TLS_ENABLED is true. Default: 365. Minimum: 1. Maximum: 365.
# MCP_TLS_CERT_VALIDITY_DAYS=365

# Password of the private key; leave it unset when the key has no password.
# Used when MCP_TLS_ENABLED is true. Secret: keep this file private.
# MCP_TLS_KEY_PASSWORD=


# === OAuth sign-in

# Identity provider callers sign in with; none serves without sign-in.
# Default: none. Choices: none, keycloak, azure, google, aws, generic-oidc.
# MCP_OAUTH_PROVIDER=none

# URL of the server for harnesses, without a path; it must start with https://, unless its host is localhost, 127.0.0.1
# or ::1.
# Used when MCP_OAUTH_PROVIDER is aws, azure, generic-oidc, google or keycloak. Required then.
# MCP_PUBLIC_BASE_URL=

# Keycloak realm URL, https://<keycloak-host>/realms/<realm>; it must equal the issuer in the tokens.
# Used when MCP_OAUTH_PROVIDER is keycloak. Required then.
# MCP_OAUTH_REALM_URL=

# Microsoft Entra directory (tenant) ID.
# Used when MCP_OAUTH_PROVIDER is azure. Required then.
# MCP_OAUTH_TENANT_ID=

# Discovery URL of the provider, which ends in /.well-known/openid-configuration; for AWS, the user pool's, not the
# login domain's.
# Used when MCP_OAUTH_PROVIDER is aws or generic-oidc. Required then.
# MCP_OAUTH_CONFIG_URL=

# Client ID that your identity provider gives the server.
# Used when MCP_OAUTH_PROVIDER is aws, azure, generic-oidc or google. Required then.
# MCP_OAUTH_CLIENT_ID=

# Client secret that your identity provider gives the server; a new value signs out all callers.
# Used when MCP_OAUTH_PROVIDER is aws, azure, generic-oidc or google. Required then. Secret: keep this file private.
# MCP_OAUTH_CLIENT_SECRET=

# Audience that every token must have; for Keycloak, MCP_PUBLIC_BASE_URL followed by MCP_PATH.
# Used when MCP_OAUTH_PROVIDER is azure, generic-oidc, google or keycloak. Required when MCP_OAUTH_PROVIDER is keycloak.
# MCP_OAUTH_AUDIENCE=

# Scopes that every token must have, separated by spaces or commas; for Azure, the exposed scope without its prefix.
# Used when MCP_OAUTH_PROVIDER is aws, azure, generic-oidc, google or keycloak. Required when MCP_OAUTH_PROVIDER is
# azure. Empty: no scope is required.
# MCP_OAUTH_REQUIRED_SCOPES=

# The server stores the sign-ins of its callers in this directory. Leave this setting at its default, and mount a volume
# on that directory. Without a volume, every caller must sign in again whenever the container is recreated.
# Used when MCP_OAUTH_PROVIDER is aws, azure, generic-oidc or google. Default: /opt/softwareag/connx/mcp/oauth-state.
# MCP_OAUTH_STORAGE_DIR=/opt/softwareag/connx/mcp/oauth-state

# Accept client ID metadata documents; false when the server cannot reach the URL a harness gives as its ID.
# Used when MCP_OAUTH_PROVIDER is aws, azure, generic-oidc or google. Default: true. Choices: false, true.
# MCP_OAUTH_ENABLE_CIMD=true

# Unused days after which a harness registration is removed; 0 keeps it for ever.
# Used when MCP_OAUTH_PROVIDER is aws, azure, generic-oidc or google. Default: 90. Minimum: 0.
# MCP_OAUTH_CLIENT_IDLE_DAYS=90


# === Vault (per-caller CONNX logins)

# Where per-caller CONNX logins come from; hashicorp needs OAuth.
# Default: none. Choices: none, hashicorp.
# MCP_CREDENTIAL_PROVIDER=none

# HashiCorp Vault URL; it must start with https://, unless its host is localhost, 127.0.0.1 or ::1.
# Used when MCP_CREDENTIAL_PROVIDER is hashicorp. Required then.
# VAULT_ADDR=

# Periodic Vault token that can only read the caller entries.
# Used when MCP_CREDENTIAL_PROVIDER is hashicorp. Required then. Secret: keep this file private.
# VAULT_TOKEN=

# For a Vault certificate from an internal CA, the path of that CA's certificate in the container; mount the file there,
# for example at /opt/softwareag/connx/mcp/vault-ca.pem.
# Used when MCP_CREDENTIAL_PROVIDER is hashicorp.
# VAULT_CACERT=

# Vault Enterprise namespace.
# Used when MCP_CREDENTIAL_PROVIDER is hashicorp.
# VAULT_NAMESPACE=

# KV version 2 mount holding the logins.
# Used when MCP_CREDENTIAL_PROVIDER is hashicorp. Default: secret.
# MCP_CREDENTIAL_VAULT_MOUNT=secret

# Path in the mount with one entry per caller.
# Used when MCP_CREDENTIAL_PROVIDER is hashicorp. Default: connx-mcp/callers.
# MCP_CREDENTIAL_VAULT_PATH=connx-mcp/callers
